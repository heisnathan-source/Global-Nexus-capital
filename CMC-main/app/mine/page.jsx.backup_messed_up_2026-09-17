export default function MinePage() {
  const router = useRouter();

  const [account, setAccount] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [showLogout, setShowLogout] = useState(false);
  const [loggingOut, setLoggingOut] = useState(false);
  const [showAvatarPicker, setShowAvatarPicker] = useState(false);
  const [selectedAvatar, setSelectedAvatar] = useState("avatar-1");
  const [avatarWaving, setAvatarWaving] = useState(false);

  useEffect(() => {
    try {
      const saved = window.localStorage.getItem("cmc_profile_avatar");

      if (saved && AVATARS.some((avatar) => avatar.id === saved)) {
        setSelectedAvatar(saved);
      }
    } catch {
      // Ignore localStorage errors.
    }
  }, []);

  useEffect(() => {
    let animationTimeout;

    function playAvatarAnimation() {
      setAvatarWaving(true);

      animationTimeout = window.setTimeout(() => {
        setAvatarWaving(false);
      }, 1900);
    }

    const interval = window.setInterval(playAvatarAnimation, 30000);

    return () => {
      window.clearInterval(interval);

      if (animationTimeout) {
        window.clearTimeout(animationTimeout);
      }
    };
  }, []);

  useEffect(() => {
    let active = true;

    async function load() {
      try {
        setLoading(true);
        setError("");

        const response = await fetch("/api/account", {
          credentials: "include",
          cache: "no-store",
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(
            data?.error ||
              data?.message ||
              "Unable to load your account."
          );
        }

        if (active) {
          setAccount(data?.account || data?.user || data);
        }
      } catch (err) {
        if (active) {
          setError(err?.message || "Unable to load your account.");
        }
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    }

    load();

    return () => {
      active = false;
    };
  }, []);

  async function logout() {
    if (loggingOut) return;

    try {
      setLoggingOut(true);

      await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "include",
      });
    } finally {
      router.replace("/login");
    }
  }

  function chooseAvatar(id) {
    setSelectedAvatar(id);

    try {
      window.localStorage.setItem("cmc_profile_avatar", id);
    } catch {
      // Ignore localStorage errors.
    }

    setShowAvatarPicker(false);
  }

  const currentAvatar = useMemo(
    () =>
      AVATARS.find((avatar) => avatar.id === selectedAvatar) ||
      AVATARS[0],
    [selectedAvatar]
  );

  const balance =
    account?.balance ??
    account?.available_balance ??
    account?.wallet_balance ??
    0;

  const rank =
    account?.rank_name ??
    account?.rank ??
    account?.level_name ??
    account?.level ??
    "Starter";

  const name =
    account?.full_name ??
    account?.name ??
    account?.username ??
    "CMC Member";

  const phone =
    account?.phone ??
    account?.phone_number ??
    account?.mobile ??
    "—";

  const registrationDate =
    account?.registration_date ??
    account?.created_at ??
    account?.registered_at ??
    null;

  function formatMoney(value) {
    const number = Number(value || 0);

    return number.toLocaleString("en-GH", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }

  function formatDate(value) {
    if (!value) return "—";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  }

  return (
    <main className="mobile-shell scroll-page mine-modern-page">
      <header className="topbar">
