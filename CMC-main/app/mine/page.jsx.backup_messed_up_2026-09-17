                gap: 12,
                marginTop: 16,
              }}
            >
              {AVATARS.map((avatar) => {
                const selected = avatar.id === selectedAvatar;

                return (
                  <button
                    key={avatar.id}
                    type="button"
                    onClick={() => chooseAvatar(avatar.id)}
                    style={{
                      position: "relative",
                      border: selected
                        ? "2px solid #31548F"
                        : "1px solid rgba(20,35,60,.10)",
                      borderRadius: 20,
                      padding: "10px 8px 12px",
                      background: selected
                        ? "rgba(49,84,143,.08)"
                        : "#fff",
                      cursor: "pointer",
                      textAlign: "center",
                      boxShadow: selected
                        ? "0 8px 24px rgba(49,84,143,.12)"
                        : "0 4px 14px rgba(20,35,60,.05)",
                    }}
                  >
                    <div
                      style={{
                        height: 150,
                        display: "grid",
                        placeItems: "center",
                      }}
                    >
                      <AvatarIllustration
                        avatar={avatar}
                        size={145}
                      />
                    </div>

                    <strong
                      style={{
                        display: "block",
                        fontSize: 14,
                      }}
                    >
                      {avatar.name}
                    </strong>

                    {selected ? (
                      <span
                        className="badge"
                        style={{
                          display: "inline-block",
                          marginTop: 6,
                        }}
                      >
                        Selected
                      </span>
                    ) : null}
                  </button>
                );
              })}
            </div>

            <button
              type="button"
              className="button"
              style={{
                width: "100%",
                marginTop: 16,
              }}
              onClick={() => setShowAvatarPicker(false)}
            >
              Done
            </button>
          </section>
        </div>
      ) : null}

      {showLogout ? (
        <div
          role="dialog"
          aria-modal="true"
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 110,
            background: "rgba(8,14,24,.62)",
            display: "grid",
            placeItems: "center",
            padding: 20,
          }}
          onClick={() => {
            if (!loggingOut) {
              setShowLogout(false);
            }
          }}
        >
          <section
            className="admin-card"
            style={{
              width: "100%",
              maxWidth: 420,
              margin: 0,
              borderRadius: 24,
            }}
            onClick={(event) => event.stopPropagation()}
          >
            <div className="admin-card-head">
              <strong>Log out?</strong>
            </div>

            <p className="muted">
              Are you sure you want to log out of your CMC account?
            </p>

            <div
              style={{
                display: "flex",
                gap: 10,
                marginTop: 18,
              }}
            >
              <button
                type="button"
                className="button secondary"
                style={{ flex: 1 }}
                disabled={loggingOut}
                onClick={() => setShowLogout(false)}
              >
                Cancel
              </button>

              <button
                type="button"
                className="button"
                style={{ flex: 1 }}
                disabled={loggingOut}
                onClick={logout}
              >
                {loggingOut ? "Logging out..." : "Confirm"}
              </button>
            </div>
          </section>
        </div>
      ) : null}

      <nav className="bottom-nav">
        <Link href="/">Home</Link>
        <Link href="/tasks">Task</Link>
        <Link href="/message">Message</Link>
        <Link href="/rank">Rank</Link>
        <Link className="active" href="/mine">
          Mine
        </Link>
      </nav>
    </main>
  );
}
