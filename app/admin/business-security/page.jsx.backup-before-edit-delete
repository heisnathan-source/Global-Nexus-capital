"use client";
import Link from "next/link";import {useState} from "react";
export default function BusinessSecurity(){const[file,setFile]=useState(null),[url,setUrl]=useState(""),[status,setStatus]=useState("");async function save(){try{let u=url;if(file){const fd=new FormData();fd.append("file",file);fd.append("folder","business-security");const r=await fetch("/api/admin/media",{method:"POST",body:fd});const d=await r.json();if(!r.ok)throw new Error(d.error);u=d.url;}const r=await fetch('/api/admin/content',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({pageKey:'business_license',title:'Business Security',content:'Official CMC company certificate',bannerUrl:u||null,active:true})});const d=await r.json();if(!r.ok)throw new Error(d.error);setUrl(u);setStatus('Certificate saved successfully.');}catch(e){setStatus(e.message)}}return <main className="mobile-shell scroll-page"><header className="topbar"><div><div className="eyebrow">CMC ADMIN</div><h1>Business Security</h1><p className="muted">Manage the company certificate</p></div><Link className="icon-button" href="/admin">←</Link></header><section className="admin-card"><strong>Company Certificate</strong><p className="muted">Upload the certificate that users will see on the Business Security page.</p><div className="form-card"><label>Certificate<input type="file" accept="image/*,.pdf" onChange={e=>setFile(e.target.files?.[0]||null)}/></label><button className="primary-button" type="button" onClick={save}>Save Certificate</button>{status&&<p className="muted">{status}</p>}</div></section></main>}
