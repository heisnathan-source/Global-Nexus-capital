"use client";import Link from "next/link";import {useEffect,useState} from "react";
export default function Message(){const[rows,setRows]=useState([]);useEffect(()=>{fetch('/api/messages').then(r=>r.json()).then(d=>setRows(d.messages||[])).catch(()=>{})},[]);async function read(id){await fetch('/api/messages',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messageId:id})});setRows(x=>x.map(m=>m.id===id?{...m,read_at:new Date().toISOString()}:m))}return <main className="mobile-shell scroll-page"><header className="topbar"><div><div className="eyebrow">CMC</div><h1>Messages</h1><p className="muted">Official CMC messages</p></div><Link className="icon-button" href="/">←</Link></header><section className="admin-card"><div className="admin-card-head"><strong>Messages</strong><span className="badge">Official</span></div>{rows.length?rows.map(m=><article className="list-row" key={m.id} onClick={()=>read(m.id)}>{m.image_url&&<img src={m.image_url} alt="" style={{width:72,height:72,objectFit:'cover',borderRadius:12}}/>}<div><strong>{m.title}</strong><span className="muted">{m.body}</span><span className="muted">{m.read_at?'Read':'Unread'}</span></div></article>):<div className="empty-document"><span>Admin messages will appear here.</span></div>}</section><nav className="bottom-nav"><Link href="/">Home</Link><Link href="/tasks">Task</Link><Link className="active" href="/message">Message</Link><Link href="/rank">Rank</Link><Link href="/mine">Mine</Link></nav></main>}
